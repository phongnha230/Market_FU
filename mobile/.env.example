# ===========================================================
# FU SecondHand Market — Mobile ENV Configuration
# Sao chép file này thành .env và điền đúng giá trị
# ===========================================================

# -------------------------------------------------------
# 1. BACKEND API — URL kết nối đến Backend Server
# -------------------------------------------------------
# 🖥️  Chạy trên máy tính (Web browser / iOS Simulator):
#     EXPO_PUBLIC_API_URL=http://localhost:5001/api
#
# 📱  Chạy Expo Go trên điện thoại thật (cùng WiFi):
#     Thay localhost → IP máy tính của bạn (xem bằng ipconfig)
#     EXPO_PUBLIC_API_URL=http://192.168.1.2:5001/api
#
# 🤖  Chạy Android Emulator (máy ảo):
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:5001/api
#
# ☁️   Production (đã deploy VPS):
#     EXPO_PUBLIC_API_URL=https://api.fusecondhandmarket.com/api
#
EXPO_PUBLIC_API_URL=http://localhost:5001/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:5001

# -------------------------------------------------------
# 2. FIREBASE — Push Notification & Phone Auth
# -------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAco0MBg0sppTmSSOOjreeOaWiTvlRrmvY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=marketfu-1cdf7.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=marketfu-1cdf7
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=marketfu-1cdf7.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=286340231733
EXPO_PUBLIC_FIREBASE_APP_ID=1:286340231733:web:1632e15aa97b2b030c377c

# -------------------------------------------------------
# 3. GOOGLE SIGN-IN — OAuth Client ID
# -------------------------------------------------------
# Dùng Web Client ID để Backend (google-auth-library) xác thực idToken
# Lấy tại: Google Cloud Console → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=1093899519891-c9r9jv1imm3s104crlhels37fl71stuo.apps.googleusercontent.com

# -------------------------------------------------------
# 4. GOOGLE ANDROID CLIENT ID (dành cho Native Sign-In khi build APK)
# -------------------------------------------------------
# Tạo riêng OAuth Client ID loại "Android" với:
#   - Package name: com.fu.secondhandmarket
#   - SHA-1: (lấy bằng lệnh keytool)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=XXXXXXXXXX.apps.googleusercontent.com
