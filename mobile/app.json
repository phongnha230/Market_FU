{
  "expo": {
    "name": "FU SecondHand",
    "slug": "fu-secondhand-market",
    "scheme": "fu-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fu.secondhandmarket",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F27024"
      },
      "package": "com.fu.secondhandmarket",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép ứng dụng sử dụng FaceID để mở khóa và bảo vệ tài khoản FU SecondHand của bạn."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F27024",
          "defaultChannel": "system_channel"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "64579c58-c93c-4eed-bb47-db519499c10c"
      }
    },
    "owner": "nhasc"
  }
}
