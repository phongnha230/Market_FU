{
  "name": "fu-secondhand-backend",
  "version": "1.0.0",
  "description": "Backend API for FU Student Second-hand Market",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/**/*.test.ts",
    "test:api": "bru run bruno-collection -r --env Local",
    "test:api:auth": "bru run bruno-collection/01-Auth --env Local",
    "test:api:products": "bru run bruno-collection/02-Products --env Local",
    "test:api:orders": "bru run bruno-collection/03-Orders --env Local",
    "test:api:payments": "bru run bruno-collection/04-Payments --env Local",
    "test:api:safehandoff": "bru run bruno-collection/05-SafeHandoff --env Local",
    "test:api:vouchers": "bru run bruno-collection/06-Vouchers --env Local",
    "test:api:admin": "bru run bruno-collection/07-Admin-And-Disputes --env Local",
    "test:lock": "tsx scripts/test-redis-distributed-lock.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "lint": "eslint src --ext .ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@google/generative-ai": "^0.24.1",
    "@payos/node": "^2.0.5",
    "@prisma/client": "6.19.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "meilisearch": "^0.62.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.6",
    "prisma": "^6.12.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "@usebruno/cli": "^4.2.0",
    "autocannon": "^8.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": ">=11.1.1"
  }
}
