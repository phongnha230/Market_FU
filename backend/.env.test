PORT=5001
NODE_ENV=test
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006

# Database mock for unit tests
DATABASE_URL="mongodb://127.0.0.1:27017/campus_market_test"

# JWT Secrets (min 32 chars)
JWT_SECRET=ci_test_jwt_secret_key_12345678901234567890123456789012
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ci_test_jwt_refresh_secret_key_12345678901234567890123456789012
JWT_REFRESH_EXPIRES_IN=30d

# Webhooks & Security Secrets (min 16 chars)
SHIPPING_WEBHOOK_SECRET=ci_test_shipping_webhook_secret_min16chars
PAYMENT_WEBHOOK_SECRET=ci_test_payment_webhook_secret_min16chars
HANDSHAKE_QR_SECRET=ci_test_handshake_qr_secret_min16chars

# Media & Services
MEDIA_DOMAIN=http://localhost:5000/uploads
UPLOAD_DIR=uploads
REDIS_URL=redis://localhost:6379
MEILISEARCH_HOST=http://localhost:7700
LOG_LEVEL=error
