meta {
  name: 06-Logout
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
