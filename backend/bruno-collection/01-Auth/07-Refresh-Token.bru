meta {
  name: 07-Refresh-Token
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/refresh-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.tokens) {
    bru.setEnvVar("token", res.body.data.tokens.accessToken);
    bru.setEnvVar("refreshToken", res.body.data.tokens.refreshToken);
  }
}

assert {
  res.status: in [200, 401]
}
