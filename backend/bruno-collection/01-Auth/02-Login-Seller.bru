meta {
  name: 02-Login-Seller
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "seller@fpt.edu.vn",
    "password": "Password123@"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.tokens) {
    bru.setEnvVar("token", res.body.data.tokens.accessToken);
    bru.setEnvVar("sellerToken", res.body.data.tokens.accessToken);
    bru.setEnvVar("refreshToken", res.body.data.tokens.refreshToken);
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.tokens.accessToken: isDefined
}
