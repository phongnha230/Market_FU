meta {
  name: 04-Get-Products
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/products?page=1&limit=20&sortBy=newest
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
  sortBy: newest
}

script:post-response {
  if (res.body && res.body.data && Array.isArray(res.body.data) && res.body.data.length > 0) {
    if (!bru.getEnvVar("productId")) {
      bru.setEnvVar("productId", res.body.data[0].id);
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isDefined
}
