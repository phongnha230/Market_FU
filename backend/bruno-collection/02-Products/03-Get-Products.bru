meta {
  name: 03-Get-Products
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/products?page=1&limit=10&campus=HOL
  body: none
  auth: none
}

script:post-response {
  if (res.body && res.body.data && res.body.data.length > 0) {
    bru.setEnvVar("productId", res.body.data[0].id);
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isDefined
}
