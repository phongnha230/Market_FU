meta {
  name: 07-Admin-Create-Voucher
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/vouchers
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "title": "Giảm 20.000đ Canteen FPT",
    "description": "Áp dụng cho mọi suất ăn trưa và nước uống tại Canteen",
    "partner": "CANTEEN",
    "coinCost": 50,
    "discountValue": 20000,
    "quantity": 100,
    "validDays": 30
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("voucherId", res.body.data.id);
  }
}

assert {
  res.status: in [201, 200, 400, 403]
}
