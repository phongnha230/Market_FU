meta {
  name: 08-Admin-Get-Users
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/users?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  if (res.body && res.body.data && Array.isArray(res.body.data) && res.body.data.length > 0) {
    if (!bru.getEnvVar("userId")) {
      bru.setEnvVar("userId", res.body.data[0].id);
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
