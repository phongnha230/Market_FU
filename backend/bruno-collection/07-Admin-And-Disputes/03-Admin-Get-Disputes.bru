meta {
  name: 03-Admin-Get-Disputes
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/reports/disputes?status=PENDING&page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  status: PENDING
  page: 1
  limit: 20
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  if (res.body && res.body.data && Array.isArray(res.body.data) && res.body.data.length > 0) {
    bru.setEnvVar("disputeId", res.body.data[0].id);
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
