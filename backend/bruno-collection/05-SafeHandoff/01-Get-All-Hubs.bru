meta {
  name: 01-Get-All-Hubs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/safe-handoff
  body: none
  auth: none
}

script:post-response {
  if (res.body && res.body.data && Array.isArray(res.body.data) && res.body.data.length > 0) {
    bru.setEnvVar("hubId", res.body.data[0].id);
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
