meta {
  name: 02-Get-Available-Vouchers
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/vouchers?page=1&limit=20
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 20
}

script:post-response {
  if (res.body && res.body.data && Array.isArray(res.body.data) && res.body.data.length > 0) {
    if (!bru.getEnvVar("voucherId")) {
      bru.setEnvVar("voucherId", res.body.data[0].id);
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
