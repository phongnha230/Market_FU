meta {
  name: 06-Seller-Update-Shipping
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/orders/{{orderId}}/shipping
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{sellerToken}}
}

body:json {
  {
    "trackingCode": "GHTK123456789",
    "status": "SHIPPING"
  }
}

assert {
  res.status: in [200, 400, 403, 404]
}
