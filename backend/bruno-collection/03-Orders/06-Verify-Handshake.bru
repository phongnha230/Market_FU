meta {
  name: 06-Verify-Handshake
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/orders/{{orderId}}/handshake
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{sellerToken}}
}

body:json {
  {
    "handshakeOtp": "1234"
  }
}

assert {
  res.status: in [200, 400, 403, 404]
}
