meta {
  name: 04-Get-My-Orders
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/orders?role=BUYER&page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  role: BUYER
  page: 1
  limit: 20
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.body && res.body.data && Array.isArray(res.body.data) && res.body.data.length > 0) {
    bru.setEnvVar("orderId", res.body.data[0].id);
    if (res.body.data[0].orderCode) {
      bru.setEnvVar("orderCode", res.body.data[0].orderCode);
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
