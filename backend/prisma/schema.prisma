datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// 1. ENUMS
// ------------------------------------------------------
enum UserRole {
  UNVERIFIED
  BUYER
  SELLER
  ADMIN
}

enum CampusLocation {
  HOL
  HCM
  DAD
  QN
  CT
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ProductCategory {
  DORM_ITEM
  BOOKS
  ELECTRONICS
  VEHICLE
  CLOTHING
  OTHER
}

enum ItemCondition {
  NEW_100
  LIKE_NEW_99
  USED_GOOD
  USED_FAIR
}

enum ProductStatus {
  PENDING_APPROVAL
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN
  EXPIRED
  REJECTED
}

enum OrderType {
  MEETUP
  SHIP_COD
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  IMAGE
  OFFER_PRICE
  MEETUP_LOCATION
}

enum AiSenderRole {
  USER
  MODEL
  SYSTEM
}

enum NotificationType {
  CHAT
  ORDER
  KYC
  SYSTEM
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CoinTransactionType {
  REVIEW_REWARD
  KYC_BONUS
  BOOST_POST
  ORDER_DISCOUNT
  BUY_BADGE
  WITHDRAWAL
  REDEEM_VOUCHER
  ADMIN_ADJUSTMENT
  BONUS
  DAILY_CHECKIN
  QUEST_REWARD
}

enum QuestCadence {
  ONCE
  DAILY
  WEEKLY
}

enum VoucherPartner {
  CANTEEN
  PASSIO
  SEVEN_ELEVEN
  OTHER
}

enum UserVoucherStatus {
  UNUSED
  USED
  EXPIRED
}

enum ReportTargetType {
  PRODUCT
  USER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// ------------------------------------------------------
// 2. EMBEDDED TYPES (TỐI ƯU CHO MONGODB)
// ------------------------------------------------------
type ProductImage {
  imageUrl     String
  isCover      Boolean @default(false)
  displayOrder Int     @default(0)
}

type UserKyc {
  studentId       String
  cardImageUrl    String            // Ảnh thẻ SV mặt trước (legacy, giữ cho tương thích)
  cardBackUrl     String?           // Ảnh thẻ SV mặt sau
  selfieCardUrl   String?           // Ảnh chân dung SV
  cccdNumber      String?           // Số CCCD 12 chữ số (bắt buộc với Seller)
  cccdFrontUrl    String?           // Ảnh CCCD mặt trước (Chip)
  cccdBackUrl     String?           // Ảnh CCCD mặt sau (Vân tay)
  status          KycStatus @default(PENDING)
  type            String?   @default("STUDENT") // "STUDENT" (Buyer KYC) | "SELLER" (Seller Onboarding)
  rejectedReason  String?
  verifiedAt      DateTime?
}

type BankAccount {
  bankName    String
  accountNo   String
  accountName String
}

type OrderPayment {
  price            Int
  shippingFee      Int       @default(0)
  coinsUsed        Int       @default(0)
  coinDiscount     Int       @default(0)
  totalAmount      Int
  vietqrUrl        String?
  payosOrderCode   Int?      // Mã orderCode cho cổng thanh toán PayOS (Web)
  payosCheckoutUrl String?   // Link thanh toán PayOS dành cho Web
  paymentMethod    String?   @default("VIETQR") // "PAYOS_WEB" | "VIETQR" | "CASH"
  isPaid           Boolean   @default(false)
  paidAt           DateTime?
}

type OrderHandshake {
  handshakeToken String
  handshakeOtp   String
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
}

type OrderShipping {
  shippingPartner String   @default("GHTK")
  trackingCode    String?
  receiverName    String
  receiverPhone   String
  shippingAddress String
  deliveredAt     DateTime?
}

// ------------------------------------------------------
// 3. MAIN COLLECTIONS (MODELS)
// ------------------------------------------------------

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  email           String         @unique
  passwordHash    String?
  role            UserRole       @default(UNVERIFIED)
  isActive        Boolean        @default(true)
  tokenVersion    Int            @default(0)

  // 1-to-1 Relation with Profile
  profile         Profile?

  // Relations
  products        Product[]      @relation("SellerProducts")
  buyerOrders     Order[]        @relation("BuyerOrders")
  sellerOrders    Order[]        @relation("SellerOrders")
  buyerChats      Conversation[] @relation("BuyerConversations")
  sellerChats     Conversation[] @relation("SellerConversations")
  sentMessages    Message[]
  givenReviews    Review[]       @relation("Reviewer")
  receivedReviews Review[]       @relation("Reviewee")
  aiSessions      AiChatSession[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]       @relation("UserDeviceTokens")
  withdrawalRequests WithdrawalRequest[]
  favorites          ProductFavorite[]   @relation("UserFavorites")
  coinTransactions   CoinTransaction[]   @relation("UserCoinTransactions")
  kycVerifications   KycVerification[]   @relation("UserKycVerifications")
  submittedReports   Report[]            @relation("UserReports")
  vouchers           UserVoucher[]       @relation("UserVouchers")
  checkIns           DailyCheckIn[]      @relation("UserCheckIns")
  questClaims        QuestClaim[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Profile {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @unique @db.ObjectId
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  avatarUrl       String?
  phoneNumber     String?
  campus          CampusLocation @default(HOL)
  campusCoins     Int            @default(0)
  reputationScore Int            @default(100)
  avatarBadge     String?        // Huy hiệu trang trí (TOP_SELLER, K18_VERIFIED, v.v.)
  cohort          String?        // Khóa học do người dùng tự nhập (ví dụ: K17, K18)
  major           String?        // Chuyên ngành do người dùng tự nhập (ví dụ: Kỹ thuật phần mềm)
  bio             String?        // Giới thiệu bản thân
  dorm            String?        // KTX (ví dụ: Dom E, Dom A)

  // Embedded KYC & Bank
  kyc             UserKyc?
  bankAccount     BankAccount?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Category {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String          @unique
  iconUrl     String?
  description String?
  category    ProductCategory @default(OTHER)
  isActive    Boolean         @default(true)
  products    Product[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Product {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  sellerId       String          @db.ObjectId
  seller         User            @relation("SellerProducts", fields: [sellerId], references: [id])
  categoryId     String?         @db.ObjectId
  category       Category?       @relation(fields: [categoryId], references: [id])
  categoryType   ProductCategory
  title          String
  description    String
  price          Int
  originalPrice  Int?
  condition      ItemCondition
  quantity       Int             @default(1)
  campus         CampusLocation
  meetupLocation String?
  allowShipping  Boolean         @default(true)
  status         ProductStatus   @default(PENDING_APPROVAL)
  rejectionReason String?
  approvedAt      DateTime?
  moderatedBy     String?         @db.ObjectId

  hashtags       String[]        // VD: ["quạt", "điện tử", "hòa lạc", "giá rẻ"]

  images         ProductImage[]
  videoUrl       String?
  videoPublicId  String?
  viewsCount     Int             @default(0)
  renewCount     Int             @default(0)
  likesCount     Int             @default(0)
  isPinned       Boolean         @default(false)
  pinnedUntil    DateTime?
  boostedAt      DateTime?
  expiredAt      DateTime?

  orders         Order[]
  conversations  Conversation[]
  favoritedBy    ProductFavorite[] @relation("ProductFavorites")

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([campus, categoryType, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([sellerId, status])
  @@index([categoryId, status])
}

model Conversation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  buyerId         String    @db.ObjectId
  buyer           User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId        String    @db.ObjectId
  seller          User      @relation("SellerConversations", fields: [sellerId], references: [id])
  productId       String    @db.ObjectId
  product         Product   @relation(fields: [productId], references: [id])
  lastMessageText String?
  lastMessageAt   DateTime?

  messages        Message[]
  createdAt       DateTime  @default(now())

  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@index([productId])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id])
  messageType    MessageType  @default(TEXT)
  text           String?
  mediaUrl       String?
  offerPrice     Int?
  meetupLocation String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([conversationId, senderId, isRead])
  @@index([senderId, isRead])
}

model Order {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  orderCode      String         @unique
  buyerId        String         @db.ObjectId
  buyer          User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId       String         @db.ObjectId
  seller         User           @relation("SellerOrders", fields: [sellerId], references: [id])
  productId      String         @db.ObjectId
  product        Product        @relation(fields: [productId], references: [id])
  orderType      OrderType
  status         OrderStatus    @default(PENDING)

  // Embedded Transaction Details
  payment        OrderPayment
  handshake      OrderHandshake?
  shipping       OrderShipping?

  warrantyHours  Int            @default(24)
  warrantyEndsAt DateTime?

  // Safe-Handoff Appointment & Meetup Location
  appointmentTime DateTime?
  meetupLocation  String?
  safePointHubId  String?

  reviews        Review[]
  dispute        Dispute?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, createdAt(sort: Desc)])
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String   @db.ObjectId
  order       Order    @relation(fields: [orderId], references: [id])
  reviewerId  String   @db.ObjectId
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId  String   @db.ObjectId
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating      Int
  comment     String?
  images      String[] // Ảnh bằng chứng (tùy chọn)
  proofVideoUrl String? // Kèm video test: thưởng +200 Xu theo Task 3.3
  isPublic    Boolean  @default(false)
  revealedAt  DateTime? // Thời điểm mở khóa công khai (blind reveal)
  createdAt   DateTime @default(now())

  // B3-7: Mỗi người chỉ được đánh giá 1 lần/đơn — chặn double-submit
  @@unique([orderId, reviewerId])
  @@index([revieweeId, isPublic])
}

model Dispute {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String   @unique @db.ObjectId
  order         Order    @relation(fields: [orderId], references: [id])
  claimantId    String   @db.ObjectId
  reason        String
  proofVideoUrl String
  status        String   @default("PENDING")
  adminNote     String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
}

model AiChatSession {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  userId      String          @db.ObjectId
  user        User            @relation(fields: [userId], references: [id])
  title       String          @default("Tìm đồ phòng trọ")
  totalTokens Int             @default(0)
  isActive    Boolean         @default(true)
  messages    AiChatMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AiChatMessage {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  sessionId           String        @db.ObjectId
  session             AiChatSession @relation(fields: [sessionId], references: [id])
  senderRole          AiSenderRole
  content             String
  suggestedProductIds String[]
  createdAt           DateTime      @default(now())
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  targetUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model WithdrawalRequest {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId
  user        User             @relation(fields: [userId], references: [id])
  amount      Int              // Số tiền muốn rút (VNĐ)
  bankAccount BankAccount      // Snapshot thông tin tài khoản ngân hàng lúc rút
  status      WithdrawalStatus @default(PENDING)
  adminNote   String?          // Ghi chú hoặc mã tham chiếu chuyển khoản của Admin
  createdAt   DateTime         @default(now())
  processedAt DateTime?

  @@index([userId, status])
  @@index([status, createdAt(sort: Desc)])
}

// ------------------------------------------------------
// 4. MỞ RỘNG TÁCH BẢNG RIÊNG (FAVORITES, COINS, KYC, REPORTS)
// ------------------------------------------------------

model ProductFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("UserFavorites", fields: [userId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation("ProductFavorites", fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
}

model CoinTransaction {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  userId       String              @db.ObjectId
  user         User                @relation("UserCoinTransactions", fields: [userId], references: [id])
  amount       Int                 // Số xu thay đổi (+100 thưởng review, -500 đổi quà)
  balanceAfter Int                 // Số dư ví sau biến động
  type         CoinTransactionType
  description  String
  referenceId  String?             // Mã tham chiếu (mã đơn hàng, mã review, v.v.)
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Quest {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  questCode     String       @unique
  title         String
  description   String
  rewardCoins   Int
  conditionType String
  cadence       QuestCadence @default(WEEKLY)
  isActive      Boolean      @default(true)
  iconType      String       @default("other")
  managedBy     String       @default("Ban Quản Trị Sàn")
  claims        QuestClaim[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive, cadence])
}

model QuestClaim {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String   @db.ObjectId
  quest     Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  cycleKey  String
  createdAt DateTime @default(now())

  @@unique([userId, questId, cycleKey])
  @@index([questId, cycleKey])
}

model KycVerification {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User?     @relation("UserKycVerifications", fields: [userId], references: [id], onDelete: Cascade)
  type           String?   @default("STUDENT") // "STUDENT" | "SELLER"
  studentId      String    // Mã số SV: SE123456
  cardImageUrl   String    // Link ảnh thẻ SV (mặt trước)
  cardBackUrl    String?   // Link ảnh thẻ SV (mặt sau)
  selfieCardUrl  String?   // Link ảnh chân dung sinh viên
  ocrData        Json?     // Dữ liệu đối soát tự động từ Gemini Vision
  aiMatchScore   Int?      // Điểm độ khớp (0-100%)
  fullName       String?   // Họ tên SV khai báo trong đơn
  campus         CampusLocation? // Cơ sở khai báo trong đơn
  cohort         String?   // Khóa học khai báo trong đơn
  major          String?   // Chuyên ngành khai báo trong đơn
  phoneNumber    String?   // Số điện thoại khai báo trong đơn
  status         KycStatus @default(PENDING)
  rejectedReason String?   // Lý do Admin từ chối
  reviewedBy     String?   @db.ObjectId // ID của Admin duyệt
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt(sort: Desc)])
}

model Report {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  reporterId String           @db.ObjectId
  reporter   User             @relation("UserReports", fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String           @db.ObjectId // ID của sản phẩm hoặc người dùng bị tố cáo
  reason     String           // Lý do: Hàng giả, Lừa đảo, Hàng cấm, v.v.
  details    String?          // Chi tiết tố cáo
  status     ReportStatus     @default(PENDING)
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([targetId, status])
  @@index([status, createdAt(sort: Desc)])
}

model Voucher {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  title         String         // Tên voucher: Voucher Cơm Căn Tin 10k, Passio Coffee 15k...
  description   String?        // Điều kiện áp dụng
  partner       VoucherPartner @default(CANTEEN)
  coinCost      Int            // Số Xu cần đổi (VD: 1000 Xu)
  discountValue Int            // Giá trị giảm (VD: 10000 VNĐ)
  quantity      Int            @default(100) // Số lượng còn lại trong kho
  imageUrl      String?        // Ảnh minh họa voucher
  validDays     Int            @default(30)  // Số ngày sử dụng sau khi đổi
  isActive      Boolean        @default(true)

  userVouchers  UserVoucher[]  @relation("VoucherRedemptions")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserVoucher {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  userId      String            @db.ObjectId
  user        User              @relation("UserVouchers", fields: [userId], references: [id])
  voucherId   String            @db.ObjectId
  voucher     Voucher           @relation("VoucherRedemptions", fields: [voucherId], references: [id])

  voucherCode String            @unique // Mã QR / Barcode để nhân viên căn tin quét (VD: FUV-PASSIO-8A3F2C)
  status      UserVoucherStatus @default(UNUSED)
  usedAt      DateTime?
  expiredAt   DateTime          // Hạn chót sử dụng

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, status])
}

model DeviceToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceType String?  // "WEB" | "ANDROID" | "IOS"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model SafeHandoffHub {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  code            String         @unique
  campus          CampusLocation
  storageCapacity String         @default("50 GB")
  cameras         String         @default("2 Cam HD")
  staffCount      String         @default("4 cán bộ")
  status          String         @default("Hoạt động") // "Hoạt động" | "Bảo trì" | "Tạm ngưng"
  isOperating     Boolean        @default(true)
  operatingHours  String         @default("07:30 - 21:00")
  locationDetails String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([campus, status])
}

model DailyCheckIn {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation("UserCheckIns", fields: [userId], references: [id], onDelete: Cascade)
  dateStr      String   // "YYYY-MM-DD" in Asia/Ho_Chi_Minh
  coinsAwarded Int      @default(20)
  createdAt    DateTime @default(now())

  @@unique([userId, dateStr])
  @@index([userId, createdAt(sort: Desc)])
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String   // ESCROW_HOLD, ESCROW_RELEASE, REFUND_BUYER, HANDSHAKE_VERIFIED, KYC_DECISION, etc.
  actor       String?  // User ID hoặc "SYSTEM" / "ADMIN"
  targetId    String?  // Order ID, User ID, hoặc Report ID
  targetCode  String?  // Mã đơn hàng (VD: ORD-123456-ABCD)
  amount      Int?     // Số tiền liên quan (VNĐ)
  metadata    Json?    // Chi tiết bổ sung (lý do, phương thức, IP)
  createdAt   DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([targetCode])
  @@index([actor])
}

model PaymentTransaction {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orderCode      String
  orderId        String?  @db.ObjectId
  gateway        String   // "PAYOS" | "VIETQR"
  amount         Int
  transactionId  String?  // Mã giao dịch ngân hàng / PayOS reference
  status         String   // "SUCCESS" | "FAILED" | "PENDING"
  rawPayload     Json?
  createdAt      DateTime @default(now())

  @@index([orderCode])
  @@index([transactionId])
}

