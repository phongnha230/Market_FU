datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// 1. ENUMS
// ------------------------------------------------------
enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum CampusLocation {
  HOL
  HCM
  DAD
  QN
  CT
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ProductCategory {
  DORM_ITEM
  BOOKS
  ELECTRONICS
  VEHICLE
  CLOTHING
  OTHER
}

enum ItemCondition {
  NEW_100
  LIKE_NEW_99
  USED_GOOD
  USED_FAIR
}

enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN
  EXPIRED
}

enum OrderType {
  MEETUP
  SHIP_COD
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  IMAGE
  OFFER_PRICE
  MEETUP_LOCATION
}

enum AiSenderRole {
  USER
  MODEL
  SYSTEM
}

enum NotificationType {
  CHAT
  ORDER
  KYC
  SYSTEM
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CoinTransactionType {
  REVIEW_REWARD
  KYC_BONUS
  BOOST_POST
  ORDER_DISCOUNT
  BUY_BADGE
  WITHDRAWAL
  REDEEM_VOUCHER
  ADMIN_ADJUSTMENT
  BONUS
}

enum VoucherPartner {
  CANTEEN
  PASSIO
  SEVEN_ELEVEN
  OTHER
}

enum UserVoucherStatus {
  UNUSED
  USED
  EXPIRED
}

enum ReportTargetType {
  PRODUCT
  USER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// ------------------------------------------------------
// 2. EMBEDDED TYPES (TỐI ƯU CHO MONGODB)
// ------------------------------------------------------
type ProductImage {
  imageUrl     String
  isCover      Boolean @default(false)
  displayOrder Int     @default(0)
}

type UserKyc {
  studentId       String
  cardImageUrl    String
  status          KycStatus @default(PENDING)
  type            String?   @default("STUDENT") // "STUDENT" (Buyer KYC) | "SELLER" (Seller Onboarding)
  rejectedReason  String?
  verifiedAt      DateTime?
}

type BankAccount {
  bankName    String
  accountNo   String
  accountName String
}

type OrderPayment {
  price            Int
  shippingFee      Int       @default(0)
  coinsUsed        Int       @default(0)
  coinDiscount     Int       @default(0)
  totalAmount      Int
  vietqrUrl        String?
  payosOrderCode   Int?      // Mã orderCode cho cổng thanh toán PayOS (Web)
  payosCheckoutUrl String?   // Link thanh toán PayOS dành cho Web
  paymentMethod    String?   @default("VIETQR") // "PAYOS_WEB" | "VIETQR" | "CASH"
  isPaid           Boolean   @default(false)
  paidAt           DateTime?
}

type OrderHandshake {
  handshakeToken String
  handshakeOtp   String
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
}

type OrderShipping {
  shippingPartner String   @default("GHTK")
  trackingCode    String?
  receiverName    String
  receiverPhone   String
  shippingAddress String
  deliveredAt     DateTime?
}

// ------------------------------------------------------
// 3. MAIN COLLECTIONS (MODELS)
// ------------------------------------------------------

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  email           String         @unique
  passwordHash    String?
  role            UserRole       @default(BUYER)
  isActive        Boolean        @default(true)
  tokenVersion    Int            @default(0)

  // 1-to-1 Relation with Profile
  profile         Profile?

  // Relations
  products        Product[]      @relation("SellerProducts")
  buyerOrders     Order[]        @relation("BuyerOrders")
  sellerOrders    Order[]        @relation("SellerOrders")
  buyerChats      Conversation[] @relation("BuyerConversations")
  sellerChats     Conversation[] @relation("SellerConversations")
  sentMessages    Message[]
  givenReviews    Review[]       @relation("Reviewer")
  receivedReviews Review[]       @relation("Reviewee")
  aiSessions      AiChatSession[]
  notifications      Notification[]
  withdrawalRequests WithdrawalRequest[]
  favorites          ProductFavorite[]   @relation("UserFavorites")
  coinTransactions   CoinTransaction[]   @relation("UserCoinTransactions")
  kycVerifications   KycVerification[]   @relation("UserKycVerifications")
  submittedReports   Report[]            @relation("UserReports")
  vouchers           UserVoucher[]       @relation("UserVouchers")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Profile {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @unique @db.ObjectId
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  avatarUrl       String?
  phoneNumber     String?
  campus          CampusLocation @default(HOL)
  campusCoins     Int            @default(0)
  reputationScore Int            @default(100)
  avatarBadge     String?        // Huy hiệu trang trí (TOP_SELLER, K18_VERIFIED, v.v.)

  // Embedded KYC & Bank
  kyc             UserKyc?
  bankAccount     BankAccount?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Category {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String          @unique
  iconUrl     String?
  description String?
  category    ProductCategory @default(OTHER)
  isActive    Boolean         @default(true)
  products    Product[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Product {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  sellerId       String          @db.ObjectId
  seller         User            @relation("SellerProducts", fields: [sellerId], references: [id])
  categoryId     String?         @db.ObjectId
  category       Category?       @relation(fields: [categoryId], references: [id])
  categoryType   ProductCategory
  title          String
  description    String
  price          Int
  originalPrice  Int?
  condition      ItemCondition
  quantity       Int             @default(1)
  campus         CampusLocation
  meetupLocation String?
  allowShipping  Boolean         @default(true)
  status         ProductStatus   @default(AVAILABLE)

  hashtags       String[]        // VD: ["quạt", "điện tử", "hòa lạc", "giá rẻ"]

  images         ProductImage[]
  videoUrl       String?
  videoPublicId  String?
  viewsCount     Int             @default(0)
  renewCount     Int             @default(0)
  likesCount     Int             @default(0)
  isPinned       Boolean         @default(false)
  pinnedUntil    DateTime?
  boostedAt      DateTime?
  expiredAt      DateTime?

  orders         Order[]
  conversations  Conversation[]
  favoritedBy    ProductFavorite[] @relation("ProductFavorites")

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Conversation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  buyerId         String    @db.ObjectId
  buyer           User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId        String    @db.ObjectId
  seller          User      @relation("SellerConversations", fields: [sellerId], references: [id])
  productId       String    @db.ObjectId
  product         Product   @relation(fields: [productId], references: [id])
  lastMessageText String?
  lastMessageAt   DateTime?

  messages        Message[]
  createdAt       DateTime  @default(now())
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id])
  messageType    MessageType  @default(TEXT)
  text           String?
  mediaUrl       String?
  offerPrice     Int?
  meetupLocation String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Order {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  orderCode      String         @unique
  buyerId        String         @db.ObjectId
  buyer          User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId       String         @db.ObjectId
  seller         User           @relation("SellerOrders", fields: [sellerId], references: [id])
  productId      String         @db.ObjectId
  product        Product        @relation(fields: [productId], references: [id])
  orderType      OrderType
  status         OrderStatus    @default(PENDING)

  // Embedded Transaction Details
  payment        OrderPayment
  handshake      OrderHandshake?
  shipping       OrderShipping?

  warrantyHours  Int            @default(24)
  warrantyEndsAt DateTime?

  reviews        Review[]
  dispute        Dispute?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String   @db.ObjectId
  order       Order    @relation(fields: [orderId], references: [id])
  reviewerId  String   @db.ObjectId
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId  String   @db.ObjectId
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating      Int
  comment     String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Dispute {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String   @unique @db.ObjectId
  order         Order    @relation(fields: [orderId], references: [id])
  claimantId    String   @db.ObjectId
  reason        String
  proofVideoUrl String
  status        String   @default("PENDING")
  adminNote     String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
}

model AiChatSession {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  userId      String          @db.ObjectId
  user        User            @relation(fields: [userId], references: [id])
  title       String          @default("Tìm đồ phòng trọ")
  totalTokens Int             @default(0)
  isActive    Boolean         @default(true)
  messages    AiChatMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AiChatMessage {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  sessionId           String        @db.ObjectId
  session             AiChatSession @relation(fields: [sessionId], references: [id])
  senderRole          AiSenderRole
  content             String
  suggestedProductIds String[]
  createdAt           DateTime      @default(now())
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  targetUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model WithdrawalRequest {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId
  user        User             @relation(fields: [userId], references: [id])
  amount      Int              // Số tiền muốn rút (VNĐ)
  bankAccount BankAccount      // Snapshot thông tin tài khoản ngân hàng lúc rút
  status      WithdrawalStatus @default(PENDING)
  adminNote   String?          // Ghi chú hoặc mã tham chiếu chuyển khoản của Admin
  createdAt   DateTime         @default(now())
  processedAt DateTime?
}

// ------------------------------------------------------
// 4. MỞ RỘNG TÁCH BẢNG RIÊNG (FAVORITES, COINS, KYC, REPORTS)
// ------------------------------------------------------

model ProductFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("UserFavorites", fields: [userId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation("ProductFavorites", fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CoinTransaction {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  userId       String              @db.ObjectId
  user         User                @relation("UserCoinTransactions", fields: [userId], references: [id])
  amount       Int                 // Số xu thay đổi (+100 thưởng review, -500 đổi quà)
  balanceAfter Int                 // Số dư ví sau biến động
  type         CoinTransactionType
  description  String
  referenceId  String?             // Mã tham chiếu (mã đơn hàng, mã review, v.v.)
  createdAt    DateTime            @default(now())
}

model KycVerification {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation("UserKycVerifications", fields: [userId], references: [id])
  type           String?   @default("STUDENT") // "STUDENT" | "SELLER"
  studentId      String    // Mã số SV: SE123456
  cardImageUrl   String    // Link ảnh thẻ SV
  status         KycStatus @default(PENDING)
  rejectedReason String?   // Lý do Admin từ chối
  reviewedBy     String?   @db.ObjectId // ID của Admin duyệt
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Report {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  reporterId String           @db.ObjectId
  reporter   User             @relation("UserReports", fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String           @db.ObjectId // ID của sản phẩm hoặc người dùng bị tố cáo
  reason     String           // Lý do: Hàng giả, Lừa đảo, Hàng cấm, v.v.
  details    String?          // Chi tiết tố cáo
  status     ReportStatus     @default(PENDING)
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Voucher {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  title         String         // Tên voucher: Voucher Cơm Căn Tin 10k, Passio Coffee 15k...
  description   String?        // Điều kiện áp dụng
  partner       VoucherPartner @default(CANTEEN)
  coinCost      Int            // Số Xu cần đổi (VD: 1000 Xu)
  discountValue Int            // Giá trị giảm (VD: 10000 VNĐ)
  quantity      Int            @default(100) // Số lượng còn lại trong kho
  imageUrl      String?        // Ảnh minh họa voucher
  validDays     Int            @default(30)  // Số ngày sử dụng sau khi đổi
  isActive      Boolean        @default(true)

  userVouchers  UserVoucher[]  @relation("VoucherRedemptions")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UserVoucher {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  userId      String            @db.ObjectId
  user        User              @relation("UserVouchers", fields: [userId], references: [id])
  voucherId   String            @db.ObjectId
  voucher     Voucher           @relation("VoucherRedemptions", fields: [voucherId], references: [id])

  voucherCode String            @unique // Mã QR / Barcode để nhân viên căn tin quét (VD: FUV-PASSIO-8A3F2C)
  status      UserVoucherStatus @default(UNUSED)
  usedAt      DateTime?
  expiredAt   DateTime          // Hạn chót sử dụng

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

