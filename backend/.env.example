# ==============================================================================
# 🚀 FU SECOND-HAND MARKET - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# 📌 HƯỚNG DẪN DÀNH CHO THÀNH VIÊN TRONG NHÓM:
# 1. Tạo bản sao của file này và đổi tên thành `.env` trong thư mục `backend/`:
#    cp .env.example .env (hoặc Copy & Paste file này đổi tên thành .env)
# 2. Điền các giá trị bên dưới theo hướng dẫn của từng mục.
# 3. Tuyệt đối KHÔNG commit file `.env` chứa key thật lên GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & CORS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# URL của Frontend Web (để cấu hình CORS & Cookie)
CLIENT_URL=http://localhost:3000

# Danh sách domain được phép gọi API (phân tách bởi dấu phẩy, hỗ trợ Web + Mobile Expo)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB Atlas hoặc MongoDB Local với Prisma ORM)
# ------------------------------------------------------------------------------
# Hướng dẫn cài đặt:
# - Tạo cụm Database miễn phí trên MongoDB Atlas (https://www.mongodb.com/atlas)
# - Hoặc dùng MongoDB local: mongodb://localhost:27017/fu_market
# - Sau khi cấu hình URL, chạy: `npx prisma generate` và `npx prisma db push`
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fu_market?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION (Xác thực đăng nhập & bảo mật phiên)
# ------------------------------------------------------------------------------
# Hướng dẫn tạo key an toàn: Mở terminal chạy lệnh:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_access_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Đăng nhập bằng Email FPT Sinh viên @fpt.edu.vn)
# ------------------------------------------------------------------------------
# Hướng dẫn lấy key:
# 1. Truy cập Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Tạo OAuth 2.0 Client ID (chọn Web Application)
# 3. Thêm Authorized JavaScript Origins và Redirect URIs theo client frontend
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 5. GOOGLE RECAPTCHA (Chống bot spam đăng ký tài khoản)
# ------------------------------------------------------------------------------
# Hướng dẫn lấy key:
# - Truy cập: https://www.google.com/recaptcha/admin (chọn reCAPTCHA v2 / v3)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ------------------------------------------------------------------------------
# 6. MEDIA STORAGE (Lưu trữ ảnh & video sản phẩm, ảnh KYC)
# ------------------------------------------------------------------------------
# Mặc định: Nếu chưa cấu hình Cloudflare R2, hệ thống TỰ ĐỘNG fallback lưu ảnh/video
# cục bộ vào thư mục `backend/uploads/` (không bắt buộc R2 khi code local).
MEDIA_DOMAIN=http://localhost:5000/uploads
UPLOAD_DIR=uploads

# (Tùy chọn - khi deploy hoặc muốn dùng Cloudflare R2 Object Storage):
# Lấy tại Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY=your_cloudflare_r2_access_key
R2_SECRET_KEY=your_cloudflare_r2_secret_key
R2_ENDPOINT=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=my-uploads
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxx.r2.dev

# ------------------------------------------------------------------------------
# 7. GEMINI AI (Trợ lý AI, Định giá & Phân tích ảnh sản phẩm)
# ------------------------------------------------------------------------------
# Hướng dẫn lấy key miễn phí:
# - Truy cập Google AI Studio: https://aistudio.google.com/app/apikey và bấm "Create API key"
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 8. FIREBASE ADMIN SDK (FCM Push Notification & Phone Auth SMS OTP)
# ------------------------------------------------------------------------------
# Hướng dẫn lấy:
# 1. Truy cập Firebase Console: https://console.firebase.google.com/
# 2. Vào Project Settings -> tab "Service accounts" -> bấm "Generate new private key"
# 3. Tải file JSON về, đổi tên thành `firebase-service-account.json` đặt vào thư mục `backend/`
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# ------------------------------------------------------------------------------
# 9. EMAIL SMTP (Nodemailer gửi mã OTP qua Gmail)
# ------------------------------------------------------------------------------
# Hướng dẫn tạo Gmail App Password:
# 1. Bật xác minh 2 bước (2FA) cho tài khoản Google của bạn
# 2. Vào https://myaccount.google.com/apppasswords
# 3. Tạo mật khẩu ứng dụng mới (16 chữ cái) và dán vào EMAIL_APP_PASSWORD
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM="Campus Marketplace FU" <no-reply@marketfu.com>

# ------------------------------------------------------------------------------
# 10. PAYOS PAYMENT GATEWAY (Cổng thanh toán VietQR Napas)
# ------------------------------------------------------------------------------
# Hướng dẫn lấy key:
# - Đăng ký tài khoản Sandbox / Live tại: https://payos.vn/
# - Vào mục Kênh kết nối -> Thông tin kết nối API để copy Client ID, API Key, Checksum Key
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# ------------------------------------------------------------------------------
# 11. WEBHOOKS & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Chuỗi bí mật HMAC tùy ý dùng để kiểm tra tính toàn vẹn dữ liệu Webhook và QR giao dịch trực tiếp
SHIPPING_WEBHOOK_SECRET=your_hmac_secret_key_for_shipping_webhook
HANDSHAKE_QR_SECRET=your_hmac_secret_for_qr_handshake

# ------------------------------------------------------------------------------
# 12. VIETQR DIRECT TEMPLATE CONFIG (img.vietqr.io)
# ------------------------------------------------------------------------------
# Cấu hình tài khoản ngân hàng để tạo mã QR chuyển khoản nhanh VietQR Napas
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=your_bank_account_number
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"
VIETQR_TEMPLATE=compact2

# ------------------------------------------------------------------------------
# 13. REDIS CACHING & DISTRIBUTED STORE (Cache-Aside & Rate Limiter)
# ------------------------------------------------------------------------------
# Kết nối Redis cục bộ hoặc Docker Container:
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=campusredispass123

# ------------------------------------------------------------------------------
# 14. MEILISEARCH FULL-TEXT & INSTANT SEARCH ENGINE
# ------------------------------------------------------------------------------
# Cấu hình tìm kiếm tiếng Việt không dấu & chịu lỗi chính tả:
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=masterKeyFU2026Secure


